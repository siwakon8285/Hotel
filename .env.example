# ===================================
# Aurora Grand Hotel — Environment
# ===================================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ:
#   cp .env.example .env

# --- Application ---
APP_ENV=development
API_PORT=8080

# --- PostgreSQL ---
# ชื่อ database สำหรับ development
POSTGRES_DB=hotel_booking
# app user แยก — ห้ามใช้ superuser postgres
POSTGRES_USER=hotel_app
# เปลี่ยนรหัสผ่านก่อนใช้จริง
POSTGRES_PASSWORD=hotel_dev_password
# host port สำหรับเชื่อมจากเครื่อง host (pgAdmin ฯลฯ)
# ใช้ 5433 เพื่อไม่ชนกับ local PostgreSQL ที่ใช้ 5432
POSTGRES_HOST_PORT=5433

# --- Database Connection ---
DATABASE_URL=postgres://hotel_app:hotel_dev_password@localhost:5433/hotel_booking?sslmode=disable

TEST_DATABASE_URL=postgres://hotel_app:hotel_dev_password@localhost:5433/hotel_booking_test?sslmode=disable
